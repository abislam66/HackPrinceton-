# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings -> API Keys). Safe for the browser.
# Without these the pages still render, but proposals and tracking are not stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Anthropic API key for shot and pitch generation (claude-opus-5-5).
ANTHROPIC_API_KEY=

# Server only. The Python model builder service (model-builder/, `uv run model-builder serve`).
MODEL_BUILDER_URL=http://127.0.0.1:8000

# Server only. Live outreach through Gmail (see docs/live-pipeline.md, "Gmail setup").
# An OAuth client (type: Web application or Desktop) in a Google Cloud project in Testing mode,
# with the demo Gmail account added as a test user. Mint the refresh token once with tools/gmail-token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Every outreach email is delivered here during the hackathon, never to the stakeholder.
OUTREACH_DELIVER_TO=
# Comma-separated. A send to any address not on this list is refused. Include OUTREACH_DELIVER_TO.
OUTREACH_ALLOWLIST=
# Public base URL for proposal links in emails, e.g. https://<your-app>.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
