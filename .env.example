# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings -> API Keys). Safe for the browser.
# Without these the pages still render, but proposals and tracking are not stored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC_. Secret key (sb_secret_...). With it and the URL, the live
# results (scouting, dossiers, models, project agent, outreach) are stored in public.records.
# Without it they go to .data/ locally, and on Vercel they last only as long as one instance.
SUPABASE_SECRET_KEY=

# Server only. Anthropic API key for shot and pitch generation (claude-opus-5-5) and the live pipeline.
ANTHROPIC_API_KEY=

# Server only. The Python model builder service (model-builder/, `uv run model-builder serve`).
MODEL_BUILDER_URL=http://127.0.0.1:8000

# Server only. Live outreach through Gmail (see docs/live-pipeline.md, "Gmail setup").
# An OAuth client (type: Web application or Desktop) in a Google Cloud project in Testing mode,
# with the demo Gmail account added as a test user. Mint the refresh token once with tools/gmail-token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The demo copy (the Send proposal dialog with the address left blank) is delivered here, never to the stakeholder.
OUTREACH_DELIVER_TO=
# Comma-separated. A send from the shared account to any address not on this list is refused. Include OUTREACH_DELIVER_TO.
OUTREACH_ALLOWLIST=
# The Gmail accounts people can send from the app as, to any address they type in the Send proposal dialog (needs
# sign-in on, and each person signed in as that account). JSON, one refresh token per account, each minted with
# tools/gmail-token signed in as that account:
#   {"abislam64@gmail.com":"<refresh token>","rafiatamir@gmail.com":"<refresh token>"}
# Everyone else can still use Open in Gmail. Unset means nobody can send to a typed address from the app.
OUTREACH_SENDERS=
# Public base URL for proposal links in emails, e.g. https://<your-app>.vercel.app. Optional on Vercel: production
# falls back to the production domain and previews to their own URL. Unset locally means localhost:3000.
PUBLIC_BASE_URL=http://localhost:3000

# Optional. Models for the live pipeline's jobs (defaults in src/lib/agent/models.ts):
# research claude-sonnet-5-5, extraction claude-haiku-5-5, outreach drafts claude-sonnet-5-5.
RESEARCH_MODEL=
EXTRACT_MODEL=
DRAFT_MODEL=

# Sign-in with Google through Supabase (src/lib/auth/policy.ts, DEPLOY.md "Sign-in"). Server only.
# Off unless this is exactly "true". When on, the internal app needs a Google sign-in; the client's proposal page,
# its tracking beacon and the sign-in pages stay open. Needs the Supabase URL and publishable key above.
AUTH_REQUIRED=
# Optional, comma-separated Google emails allowed in. Unset means any Google account.
ALLOWED_EMAILS=

# Building viewer generator (src/features/building-viewer, DEPLOY.md). Server only.
# Google Geocoding API key (address to coordinates). Without it the viewer runs with no map context.
GOOGLE_MAPS_KEY=
# Access code the page asks for. The generator refuses every request until this is set.
BUILDING_VIEWER_ACCESS_CODE=
