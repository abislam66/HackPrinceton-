# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings -> API Keys). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used by data ingestion scripts and admin writes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server only. LLM provider key for the policy score agent (provider not chosen yet).
POLICY_AGENT_API_KEY=
