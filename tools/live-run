#!/usr/bin/env node
// Watch the live pipeline from a terminal: starts a run on the local dev server and prints its
// progress as it streams, then a short summary of the result.
//
//   tools/live-run scout                      all five regions
//   tools/live-run scout boston new-jersey    some regions
//   tools/live-run dossier                    Morgan Hall North (demo-project)
//   tools/live-run dossier <scout-id>         a scouted project
//   tools/live-run replay scout|dossier [id]  re-stream the last recorded run at 4x
//   tools/live-run draft client-a             draft a stakeholder's email (sends nothing)
//   tools/live-run outreach                   Gmail status, sent emails, replies
//
// BASE_URL picks the server (default http://localhost:3016).

const BASE = process.env.BASE_URL ?? "http://localhost:3016";
const REGIONS = ["new-york", "philadelphia-main-line", "connecticut", "boston", "new-jersey"];
const [command, ...args] = process.argv.slice(2);

const dim = (s) => `\x1b[2m${s}\x1b[0m`;
const bold = (s) => `\x1b[1m${s}\x1b[0m`;
const red = (s) => `\x1b[31m${s}\x1b[0m`;
const green = (s) => `\x1b[32m${s}\x1b[0m`;

function usage() {
  console.log(`usage: tools/live-run scout [region...] | dossier [project] | replay scout|dossier [project] | draft <client> | outreach
regions: ${REGIONS.join(", ")}`);
  process.exit(1);
}

function printScout(data) {
  console.log(bold(`\n${data.candidates.length} projects from ${data.sources.length} sources (${data.regions.join(", ")})`));
  for (const c of data.candidates) {
    console.log(`  ${String(c.score).padStart(3)}  ${bold(c.name)}  ${dim(`${c.city}, ${c.state} · ${c.stage}${c.completion ? ` ${c.completion}` : ""}`)}`);
    console.log(`       ${c.whyItFits}`);
    console.log(dim(`       id: ${c.id} · sources: ${c.sourceIds.join(", ")}`));
  }
}

function printDossier(data) {
  const publisher = new Map(data.sources.map((s) => [s.id, s.publisher]));
  console.log(bold(`\n${data.projectName}`), dim(data.address ?? ""));
  console.log(data.summary.text);
  console.log(bold("\nFirms"));
  for (const f of data.firms) {
    const from = [...new Set(f.sourceIds.map((id) => publisher.get(id)))].join(", ");
    console.log(`  ${f.role.padEnd(22)} ${f.name}${f.website ? dim(` ${f.website}`) : ""} ${dim(`(${from})`)}`);
  }
  if (data.missingRoles.length) console.log(dim(`  not confirmed: ${data.missingRoles.join(", ")}`));
  console.log(bold("\nTimeline"));
  for (const t of data.timeline) console.log(`  ${t.when.padEnd(16)} ${t.what}`);
  console.log(dim(`\n${data.sources.length} sources`));
}

async function stream(path, body, printResult) {
  const started = Date.now();
  const response = await fetch(`${BASE}${path}`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: body ? JSON.stringify(body) : undefined,
  });
  if (!response.ok || !response.body) {
    console.log(red(`HTTP ${response.status}: ${await response.text()}`));
    process.exit(1);
  }
  const decoder = new TextDecoder();
  let buffer = "";
  for await (const chunk of response.body) {
    buffer += decoder.decode(chunk, { stream: true });
    let newline;
    while ((newline = buffer.indexOf("\n")) >= 0) {
      const line = buffer.slice(0, newline).trim();
      buffer = buffer.slice(newline + 1);
      if (!line) continue;
      const event = JSON.parse(line);
      const at = `${(event.at / 1000).toFixed(1).padStart(6)}s`;
      if (event.type === "progress") {
        const scope = (event.scope ?? "").padEnd(22);
        console.log(`${dim(at)}  ${dim(scope)} ${event.kind.padEnd(6)} ${event.message}`);
      } else if (event.type === "result") {
        console.log(green(`${at}  done (${event.source})`));
        printResult(event.data);
      } else if (event.type === "error") {
        console.log(red(`${at}  failed: ${event.message}`));
        if (event.fallback) {
          console.log(dim(`showing the ${event.fallback.source} instead`));
          printResult(event.fallback.data);
        }
      }
    }
  }
  console.log(dim(`\n${((Date.now() - started) / 1000).toFixed(0)} s total`));
}

async function main() {
  switch (command) {
    case "scout": {
      const bad = args.filter((r) => !REGIONS.includes(r));
      if (bad.length) usage();
      await stream("/api/scout/runs", args.length ? { regions: args } : {}, printScout);
      break;
    }
    case "dossier":
      await stream(`/api/dossiers/${args[0] ?? "demo-project"}/runs`, null, printDossier);
      break;
    case "replay": {
      const [stage, project = "demo-project"] = args;
      if (stage === "scout") await stream("/api/scout/runs?replay=1&speed=4", {}, printScout);
      else if (stage === "dossier") await stream(`/api/dossiers/${project}/runs?replay=1&speed=4`, null, printDossier);
      else usage();
      break;
    }
    case "draft": {
      if (!args[0]) usage();
      const response = await fetch(`${BASE}/api/outreach/${args[0]}/draft?force=1`, { method: "POST" });
      const message = await response.json();
      if (!response.ok) return console.log(red(`HTTP ${response.status}: ${message.error}`));
      console.log(dim(`drafted by: ${response.headers.get("x-draft-source")} · for ${message.intendedFor.name}, ${message.intendedFor.company}`));
      console.log(bold(`Subject: ${message.subject}\n`));
      console.log(message.body);
      break;
    }
    case "outreach":
      console.log(JSON.stringify(await (await fetch(`${BASE}/api/outreach`)).json(), null, 2));
      break;
    default:
      usage();
  }
}

main().catch((error) => {
  console.error(red(error.cause?.code === "ECONNREFUSED" ? `No server at ${BASE}. Start the dev server first.` : String(error)));
  process.exit(1);
});
